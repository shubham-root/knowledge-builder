#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
kb-obsidian — policy wrapper around Obsidian's command-line interface.

The Knowledge Builder agent (running inside ``pi --mode rpc``) is told via
its skills to invoke ``kb-obsidian <cmd> [key=value]...`` for every vault
operation.  Read commands pass straight through to the real ``obsidian``
binary; write commands are *intercepted* in shadow mode and recorded
to a JSONL plan file without touching the vault, or passed through
in apply mode (the default).

Modes
-----
``KB_AGENT_MODE=apply`` (**default**)
    Every command — read or write — passes through to the real
    ``obsidian`` binary.  Each accepted write is also logged as a JSON
    line to ``$KB_PLAN_FILE`` with ``applied=true`` plus the obsidian
    exit code, giving a uniform audit trail across modes.  Obsidian's
    own File Recovery plugin is the undo path.

``KB_AGENT_MODE=shadow``
    Write commands return a mock-success JSON to the caller and append a
    plan entry to ``$KB_PLAN_FILE`` without touching the vault.  Used
    for scripted review of agent behaviour before promoting to apply
    or for debugging skill regressions.

Always-blocked
--------------
``eval`` is unconditionally rejected (arbitrary JS in the Obsidian app).

Required env vars
-----------------
``KB_PLAN_FILE``
    Path to the JSONL file the wrapper appends to in shadow mode.  Created
    if absent.  In apply mode this var is read but only used to produce a
    parallel audit log so the operator can compare what was applied with
    what would have been planned.

``KB_AGENT_MODE``
    ``shadow`` | ``apply``.  Defaults to ``shadow`` when unset.

Optional env vars
-----------------
``KB_OBSIDIAN_BIN``
    Override the path to the real Obsidian CLI.  Defaults to ``obsidian``
    on ``$PATH``.

Exit codes
----------
``0``   success
``1``   wrapper-internal error (bad args, blocked command, missing env)
``≥2``  passthrough exit code from the real ``obsidian`` binary
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# ── Command classification ────────────────────────────────────────────────────
#
# These lists encode the Knowledge Builder shadow/apply boundary.  Anything
# not in either list is rejected so the agent cannot stumble into an
# undocumented Obsidian subcommand that mutates the vault.

READ_COMMANDS: frozenset[str] = frozenset({
    # File / folder inspection
    "file", "files", "folder", "folders",
    # Reading
    "read",
    "outline",
    # Search
    "search", "search:context",
    # Graph
    "backlinks", "links", "unresolved", "orphans", "deadends",
    # Properties / aliases / tags
    "tags", "aliases", "properties", "property:read",
    # Daily notes (read-only subset)
    "daily:path", "daily:read",
    # Bases
    "bases", "base:views", "base:query",
    # Bookmarks
    "bookmarks",
    # History / sync — read-only ops only
    "diff", "history", "history:list", "history:read",
    # Misc info
    "version", "help",
})

WRITE_COMMANDS: frozenset[str] = frozenset({
    "create", "append", "prepend",
    "move", "rename", "delete",
    "property:set", "property:remove",
    "daily:append", "daily:prepend",
    "bookmark",
    "base:create",
})

BLOCKED_COMMANDS: frozenset[str] = frozenset({
    "eval",                      # arbitrary JS in the Obsidian app
    "history:restore",           # mutating, but bypasses our plan path
    "plugin:enable", "plugin:disable", "plugin:install", "plugin:uninstall",
    "plugin:reload", "plugins:restrict",
    "publish:add", "publish:remove",
    "sync",                      # toggling Sync from the agent is out of scope
    "reload", "restart", "devtools", "dev:screenshot",
})

DEFAULT_OBSIDIAN_BIN = "obsidian"
DEFAULT_MODE = "apply"

# Argument tokens in the Obsidian CLI must be of the form `key=value` or
# bare-word boolean flags.  Any token starting with `-` indicates the LLM
# is using POSIX-style syntax and would crash the real obsidian binary;
# we reject early with an explicit error.
_DASH_ARG_RE = ("-",)

# Argument keys whose values may contain a vault-relative or absolute
# path that we must validate against vault_root / sources_dir / agent_root.
#
# We include ``file`` and ``name`` here because some Obsidian commands
# (notably ``create``) accept ``name=<filename>`` and the agent has been
# observed to abuse ``file=<path>`` for write operations.  We treat
# values without a ``/`` separator as bare wikilink/name targets and
# skip the path check; values with a ``/`` are validated.
_PATH_KEYS: frozenset[str] = frozenset({"path", "to", "file", "name"})

# ── Wrapper logic ─────────────────────────────────────────────────────────────


def _emit_error(message: str, *, exit_code: int = 1) -> None:
    """Print an agent-readable JSON error and exit."""
    sys.stdout.write(json.dumps({
        "status": "error",
        "error":  message,
        "wrapper": "kb-obsidian",
    }) + "\n")
    sys.exit(exit_code)


def _parse_mode() -> str:
    raw = os.environ.get("KB_AGENT_MODE", DEFAULT_MODE).strip().lower()
    if raw not in ("shadow", "apply"):
        _emit_error(
            f"KB_AGENT_MODE must be 'shadow' or 'apply', got {raw!r}"
        )
    return raw


def _plan_file() -> Path:
    raw = os.environ.get("KB_PLAN_FILE", "").strip()
    if not raw:
        _emit_error(
            "KB_PLAN_FILE not set; the daemon must export it before "
            "spawning the agent subprocess.",
        )
    p = Path(raw)
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def _real_obsidian_bin() -> str:
    raw = os.environ.get("KB_OBSIDIAN_BIN", DEFAULT_OBSIDIAN_BIN)
    resolved = shutil.which(raw)
    if not resolved:
        _emit_error(
            f"Obsidian CLI '{raw}' not found on PATH.  Enable it in "
            "Obsidian: Settings → General → Command line interface."
        )
    return resolved


def _classify(cmd: str) -> str:
    """Return one of: 'read', 'write', 'blocked', 'unknown'."""
    if cmd in BLOCKED_COMMANDS:
        return "blocked"
    if cmd in READ_COMMANDS:
        return "read"
    if cmd in WRITE_COMMANDS:
        return "write"
    return "unknown"


def _check_arg_syntax(args: list[str]) -> None:
    """Reject POSIX-style ``--flag`` / ``-x`` tokens early.

    Obsidian CLI uses ``key=value`` and bare-word flags.  An LLM that
    falls back to POSIX style produces tokens that the real ``obsidian``
    rejects with confusing error messages; better to fail here with a
    clear pointer back to the syntax rules.
    """
    for tok in args:
        if tok.startswith("--") or (len(tok) >= 2 and tok.startswith("-") and tok[1].isalpha()):
            _emit_error(
                f"argument {tok!r} uses POSIX-style syntax (--key value).  "
                "Obsidian CLI requires `key=value` (no dashes).  "
                "Example: `kb-obsidian create path=Notes/Foo.md content=hi`."
            )


def _parse_kv_args(args: list[str]) -> dict[str, str]:
    """Pull key=value tokens into a dict (ignores bare-word flags).

    Used only for path-invariant validation; the original argv is what's
    actually forwarded to obsidian, so this never alters caller intent.
    """
    out: dict[str, str] = {}
    for tok in args:
        eq = tok.find("=")
        if eq <= 0:
            continue              # bare flag or malformed; ignore
        key = tok[:eq].strip()
        val = tok[eq + 1:]
        out[key] = val
    return out


def _resolve_in_vault(value: str, vault_root: Path) -> Path:
    """Resolve a CLI path argument to an absolute Path under vault_root.

    * Absolute paths are taken as-is.
    * Relative paths are joined with ``vault_root``.
    * The result is canonicalised (symlinks resolved).
    """
    p = Path(value)
    if not p.is_absolute():
        p = vault_root / p
    # ``resolve(strict=False)`` allows non-existent paths (the agent may
    # be proposing to *create* them) while still resolving any ``..`` /
    # symlink components.
    return p.resolve(strict=False)


def _check_path_invariant(
    cmd:  str,
    args: list[str],
) -> None:
    """Enforce three constraints on every write-command path argument:

    1. Resolves under ``KB_VAULT_ROOT`` (vault containment).
    2. Resolves OUTSIDE ``KB_SOURCES_DIR`` (sources dir is read-only).
    3. Resolves under ``KB_AGENT_ROOT`` (agent's mutation sandbox).

    Skipped silently when ``KB_VAULT_ROOT`` or ``KB_SOURCES_DIR`` are
    unset (e.g. unit tests with stub binaries that don't care about
    location).  ``KB_AGENT_ROOT`` constraint is only enforced when set;
    its absence is fail-safe (we'd rather block too few writes than
    too many during a bad rollout, and tests can opt out cleanly).
    In production all three are exported by the daemon.
    """
    vault_root_raw  = os.environ.get("KB_VAULT_ROOT",  "").strip()
    sources_dir_raw = os.environ.get("KB_SOURCES_DIR", "").strip()
    agent_root_raw  = os.environ.get("KB_AGENT_ROOT",  "").strip()
    if not vault_root_raw or not sources_dir_raw:
        return

    vault_root  = Path(vault_root_raw).resolve(strict=False)
    sources_dir = Path(sources_dir_raw).resolve(strict=False)
    agent_root  = Path(agent_root_raw).resolve(strict=False) if agent_root_raw else None

    kv = _parse_kv_args(args)
    candidates: list[tuple[str, str]] = []
    for key in _PATH_KEYS:
        if key in kv:
            candidates.append((key, kv[key]))

    for key, raw_val in candidates:
        # Bare wikilink / filename values (no ``/``) are not path-like —
        # the agent is targeting an existing note by wikilink resolution
        # and Obsidian decides where to apply the operation.  We cannot
        # pre-validate without running obsidian, so we skip these.  Any
        # value with a ``/`` (or absolute) we DO validate.
        if "/" not in raw_val and not Path(raw_val).is_absolute():
            continue

        resolved = _resolve_in_vault(raw_val, vault_root)

        # Must live under vault_root.
        try:
            resolved.relative_to(vault_root)
        except ValueError:
            _emit_error(
                f"path {raw_val!r} (resolved {resolved}) is outside "
                f"vault_root {vault_root}.  All vault paths must be "
                "relative to or inside the vault root."
            )

        # Must NOT live inside sources_dir.
        try:
            resolved.relative_to(sources_dir)
        except ValueError:
            pass                    # good — outside sources_dir
        else:
            _emit_error(
                f"path {raw_val!r} (resolved {resolved}) is inside "
                f"sources_dir {sources_dir}.  Writes to sources_dir are "
                "forbidden by Knowledge Builder policy."
            )

        # Must live under agent_root (when configured).
        if agent_root is not None:
            try:
                resolved.relative_to(agent_root)
            except ValueError:
                # Display the relative form so the agent sees how to fix
                # its argument.
                try:
                    relative_hint = agent_root.name
                except Exception:
                    relative_hint = "KnowledgeBase"
                _emit_error(
                    f"path {raw_val!r} (resolved {resolved}) is outside "
                    f"agent_root {agent_root}.  All agent mutations must "
                    f"be inside the agent's sandbox; prefix the path with "
                    f"'{relative_hint}/'.  Example: "
                    f"'path={relative_hint}/Topics/Foo.md'."
                )


def _append_plan_entry(plan_file: Path, entry: dict) -> None:
    """Append a single JSON object to the plan file as a JSONL line."""
    line = json.dumps(entry, ensure_ascii=False, sort_keys=True)
    with plan_file.open("a", encoding="utf-8") as f:
        f.write(line + "\n")


def _passthrough(bin_path: str, cmd: str, args: list[str]) -> int:
    """Invoke the real ``obsidian`` and stream its stdout/stderr.

    Returns the child exit code.  We do NOT capture; we forward bytes so
    that large outputs (full vault search) stream without buffering.
    """
    proc = subprocess.run([bin_path, cmd, *args])
    return proc.returncode


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        _emit_error("usage: kb-obsidian <command> [key=value]... [flag]...")

    cmd  = argv[1]
    args = argv[2:]
    mode = _parse_mode()

    classification = _classify(cmd)

    # Plan file is always required, in both modes, so we have a uniform
    # audit log regardless of which mode the operator runs.
    plan_file = _plan_file()

    if classification == "blocked":
        _emit_error(
            f"command {cmd!r} is blocked by kb-obsidian policy.  See "
            "docs/agent.md for the allowlist."
        )

    if classification == "unknown":
        _emit_error(
            f"command {cmd!r} is not in the kb-obsidian allowlist.  Use "
            "one of: " + ", ".join(sorted(READ_COMMANDS | WRITE_COMMANDS))
        )

    # Reject POSIX-style argument tokens before they reach obsidian.
    _check_arg_syntax(args)

    # For write commands, enforce the path invariant *before* we either
    # log them to the plan or pass them through.
    if classification == "write":
        _check_path_invariant(cmd, args)

    # ── Read path ────────────────────────────────────────────────────────
    if classification == "read":
        bin_path = _real_obsidian_bin()
        rc = _passthrough(bin_path, cmd, args)
        return rc

    # ── Write path ───────────────────────────────────────────────────────
    assert classification == "write"

    entry = {
        "ts":      int(time.time()),
        "mode":    mode,
        "cmd":     cmd,
        "args":    args,
        "applied": False,
    }

    if mode == "apply":
        bin_path = _real_obsidian_bin()
        rc = _passthrough(bin_path, cmd, args)
        entry["applied"]    = (rc == 0)
        entry["exit_code"]  = rc
        _append_plan_entry(plan_file, entry)
        return rc

    # Shadow mode: record the intended mutation, return mock-success JSON.
    _append_plan_entry(plan_file, entry)
    sys.stdout.write(json.dumps({
        "status":  "ok",
        "mode":    "shadow",
        "cmd":     cmd,
        "args":    args,
        "note":    "no mutation applied; recorded to plan",
    }, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
